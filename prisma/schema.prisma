// Points at Supabase Postgres. DATABASE_URL is the pooled ("Transaction
// mode") connection string, used by the running app; DIRECT_URL is the
// direct ("Session mode") connection, used only when running migrations,
// since PgBouncer's transaction pooling doesn't support the prepared
// statements migrations need.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  TEACHER
  ADMIN
}

enum ClockType {
  IN
  OUT
}

enum PayType {
  HOURLY
  PER_JOB
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  name          String
  role          Role     @default(TEACHER)
  title         String?
  payType       PayType  @default(HOURLY)
  boundDeviceId String?
  createdAt     DateTime @default(now())

  clockEvents        ClockEvent[]
  sessions           Session[]
  pushSubscriptions  PushSubscription[]
  correctionRequests CorrectionRequest[]
  deviceRequests     DeviceRequest[]
}

model ClockEvent {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           ClockType
  timestamp      DateTime  @default(now())
  tagId          String    @default("chabad-door")
  reminderSentAt DateTime?

  @@index([userId, timestamp])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model CorrectionRequest {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedStart DateTime
  requestedEnd   DateTime
  reason         String
  status         RequestStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  @@index([userId, status])
}

model SchoolClosure {
  id        String   @id @default(cuid())
  date      DateTime @unique
  label     String?
  createdAt DateTime @default(now())
}

model NfcTag {
  id          String   @id @default(cuid())
  uid         String   @unique
  label       String
  lastCounter Int      @default(-1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeviceRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  deviceLabel String?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  @@index([userId, status])
}

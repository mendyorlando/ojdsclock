{
  "expo": {
    "name": "OJDS Clock",
    "slug": "ojds-clock",
    "scheme": "ojdsclock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/f199c8f1-cd59-40c7-ac71-522127d3e57a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.ojds.clock",
      "appleTeamId": "WN48H47YZX",
      "associatedDomains": [
        "applinks:ojdsclock.vercel.app"
      ],
      "buildNumber": "6"
    },
    "android": {
      "package": "org.ojds.clock",
      "adaptiveIcon": {
        "backgroundColor": "#0b3b38",
        "foregroundImage": "./assets/splash-icon.png",
        "monochromeImage": "./assets/splash-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ojdsclock.vercel.app",
              "pathPrefix": "/c/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.NFC",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "selectIdentifiers": [
            "D2760000850101"
          ],
          "nfcPermission": "Allow OJDS Clock to read the entrance tag to clock you in and out.",
          "includeNdefEntitlement": false
        }
      ],
      "expo-secure-store",
      "expo-router",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "OJDS Clock uses your location to remind you to clock out when you leave the building.",
          "locationWhenInUsePermission": "OJDS Clock uses your location to remind you to clock out when you leave the building.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0f766e"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0b3b38"
        }
      ],
      "./plugins/withSpacePathFix",
      "./plugins/withNdefIntentFilter",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f199c8f1-cd59-40c7-ac71-522127d3e57a"
      }
    },
    "owner": "chabadwg"
  }
}

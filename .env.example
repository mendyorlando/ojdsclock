# Supabase Postgres. From Project Settings -> Database -> Connection
# string: DATABASE_URL is the "Transaction" pooler URL (port 6543), used
# by the running app; DIRECT_URL is the "Session" pooler or direct URL
# (port 5432), used only for running migrations.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres"

# Push notifications (long-shift reminders). Generate your own with:
#   npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourschool.org"

# Shared secret so only your scheduled job (e.g. Vercel Cron) can trigger
# the long-shift check from outside the admin UI.
CRON_SECRET="change-me"

# AES-128 keys (32 hex chars each, e.g. from
# `node -e "console.log(require('crypto').randomBytes(16).toString('hex').toUpperCase())"`)
# that must exactly match what's programmed into your NTAG 424 DNA tags'
# SDM Meta Read Key and SDM File Read Key slots via NXP TagWriter. See
# "Programming a real NFC tag" below.
NTAG_SDM_META_KEY=""
NTAG_SDM_FILE_KEY=""

# Fallback GPS check, used only for a plain NFC tag URL (one with no
# picc_data/cmac query params). Center point and allowed radius in
# meters around the school.
SCHOOL_LAT=""
SCHOOL_LNG=""
SCHOOL_RADIUS_METERS="150"
